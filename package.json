{
  "name": "agenticf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "security:secrets": "secretlint \"**/*\"",
    "security:audit": "pnpm audit --audit-level=high",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm security:secrets"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "lefthook": "^2.2.2",
    "secretlint": "^14.0.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  }
}
