NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 17 (construye DATABASE_URL con esquema postgresql + usuario, password, host:5432 y db)
POSTGRES_USER=agenticf
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=agenticf
DATABASE_URL=

# Seguridad / CORS (en produccion usa tu dominio HTTPS, nunca "*")
CORS_ORIGIN=http://localhost:5173

# Observabilidad (Sentry Developer gratis o GlitchTip self-hosted; vacio = desactivado)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Opcional (0..1): por defecto 1.0 en development/test y 0.1 en production
SENTRY_TRACES_SAMPLE_RATE=

# Clave maestra para cifrado AES-256-GCM de credenciales IA (OAuth ChatGPT Plan Sharing + BYOK)
AI_VAULT_SECRET=change_me_at_least_16_chars_for_aes_256_gcm
